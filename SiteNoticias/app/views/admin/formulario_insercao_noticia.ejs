<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulário de Cadastro de Notícia</title>
</head>
<body>
    <main>
        <h1>Adicionar Notícia</h1>

        <section>

            <% if (validacao) { %>
                <ul>
                    <% for (let i = 0; i < validacao.length; i++) { %>
                       <li><%= validacao[i].msg%></li>
                   <% } %>
                </ul>
           <% } %>

            <form action="/noticias/salvar" method="post">
                <p>
                    <label for="titulo">Título</label>
                    <input type="text" name="titulo" id="titulo" value="<%= noticia.titulo%>" placeholder="Titulo da Noticia">
                </p>

                <p>
                    <label for="resumo">Resumo</label>
                    <input type="text" name="resumo" id="resumo" value="<%= noticia.resumo%>" placeholder="Resumo da Noticia">
                </p>

                <p>
                    <label for="autor">Autor</label>
                    <input type="text" name="autor" id="autor" value="<%= noticia.autor%>" placeholder="Autor da Noticia">
                </p>

                <p>
                    <label for="data_noticia">Data dos fatos</label>
                    <input type="date" name="data_noticia" id="data_noticia" value="<%= noticia.data_noticia%>">
                </p>
                
                <p>
                    <label for="noticia">Notícia</label>
                    <textarea name="noticia" id="noticia" cols="30" rows="10"><%= noticia.noticia%></textarea>
                </p>
               
                <p>
                    <input type="submit" value="Salvar">
                </p>   
            </form>
        </section>
    </main>
    
</body>
</html>